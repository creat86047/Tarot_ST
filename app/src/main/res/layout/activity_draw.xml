<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tarot_bg_dark"
    android:padding="16dp">

    <!-- Header & Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_draw"
        android:textColor="@color/tarot_gold_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_draw_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="問題：近期事業突破點"
        android:textColor="@color/tarot_text_secondary"
        android:textSize="13sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Current Draw Status Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/tarot_surface"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tv_draw_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="請點擊下方「抽牌」按鈕，抽取 第 1 張牌【現狀】"
            android:textColor="@color/tarot_gold_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_deck_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="牌庫狀況：已混合 78 張牌（正逆位隨機）"
            android:textColor="@color/tarot_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Interactive Deck & Drawing Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_draw_card"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_draw_card"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/tarot_gold_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shuffle_deck"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="重新洗牌"
            android:textColor="@color/tarot_text_primary"
            android:textSize="13sp"
            android:backgroundTint="@color/tarot_surface_variant" />
    </LinearLayout>

    <!-- Drawn Cards List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_drawn_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <!-- Bottom Report Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_report"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/btn_view_report"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/tarot_gold_accent" />

</LinearLayout>
