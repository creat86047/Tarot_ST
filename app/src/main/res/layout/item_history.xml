<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="@color/tarot_surface"
    android:elevation="3dp">

    <!-- Top Row: Date & Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_history_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026/11/23 14:00"
            android:textColor="@color/tarot_gold_light"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_delete_history"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刪除紀錄"
            android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_history_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="問題：近期事業突破點"
        android:textColor="@color/tarot_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_history_spread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="牌陣：五牌陣"
        android:textColor="@color/tarot_gold_accent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_history_cards_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="抽牌摘要：1. 愚者(正位) | 2. 高塔(逆位)"
        android:textColor="@color/tarot_text_secondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
