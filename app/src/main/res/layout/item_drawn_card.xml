<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="@color/tarot_surface"
    android:elevation="3dp">

    <!-- Header: Position Title & Lock Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_card_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="第 1 張 • 現狀"
            android:textColor="@color/tarot_gold_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 已鎖定"
            android:textColor="@color/tarot_gold_light"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@color/tarot_surface_variant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/tarot_card_border" />

    <!-- Card Name & Orientation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="高塔 (The Tower)"
            android:textColor="@color/tarot_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_orientation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="逆位"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@color/tarot_reversed_crimson" />
    </LinearLayout>

    <!-- Details -->
    <TextView
        android:id="@+id/tv_arcana_suit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="大阿爾克那 • 主牌"
        android:textColor="@color/tarot_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_keywords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="關鍵字：抗拒變革、緊抓殘局、延遲爆發"
        android:textColor="@color/tarot_gold_light"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="象徵崩解虛幻的結構，雖然震撼卻是重獲新生的契機。"
        android:textColor="@color/tarot_text_primary"
        android:textSize="13sp" />

</LinearLayout>
