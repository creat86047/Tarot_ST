<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/tarot_surface"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_deck_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tarot_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_deck_card_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/tarot_gold_light"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_deck_card_keywords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/tarot_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_deck_card_upright_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tarot_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_deck_card_reversed_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tarot_text_primary"
        android:textSize="13sp" />

</LinearLayout>
