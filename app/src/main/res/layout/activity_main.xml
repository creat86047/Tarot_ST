<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tarot_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Tarot Tower Logo"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/tarot_gold_accent"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/tarot_text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginVertical="32dp"
            android:background="@color/tarot_purple_primary" />

        <!-- Main Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_reading"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/start_reading"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/tarot_gold_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_browse_deck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/browse_deck"
            android:textColor="@color/tarot_text_primary"
            android:textSize="16sp"
            android:backgroundTint="@color/tarot_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/about_app"
            android:textColor="@color/tarot_text_secondary"
            android:textSize="15sp"
            android:backgroundTint="@color/tarot_surface_variant" />

        <!-- Tower Feature Highlights Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/tarot_surface"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_feature_title"
                android:textColor="@color/tarot_gold_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/main_feature_summary"
                android:textColor="@color/tarot_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
